PORT=5000

# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/fic_banking

# For MongoDB Atlas (Cloud Database):
# Get your connection string from MongoDB Atlas dashboard
# Replace <username>, <password>, and add database name before '?'
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fic_banking?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_here_CHANGE_THIS_IN_PRODUCTION
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Setup Instructions:
# 1. Copy this file to .env
# 2. Follow MONGODB_ATLAS_SETUP.md for detailed MongoDB Atlas setup
# 3. Generate a strong JWT_SECRET using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 4. Update MONGODB_URI with your actual MongoDB Atlas connection string
# 5. Set NODE_ENV to 'production' when deploying
# 6. Update FRONTEND_URL to your production frontend URL
